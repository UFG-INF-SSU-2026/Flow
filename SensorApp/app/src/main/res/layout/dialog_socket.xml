<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Endereco IP do servidor"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ex: 192.168.0.10"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Porta"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etPorta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ex: 5000"
        android:inputType="number"
        android:layout_marginBottom="16dp" />

    <!-- CA do servidor: o app a baixa sozinho ao salvar com usuario e senha; a importacao manual e so o plano B -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Certificado do servidor (CA, baixado automaticamente)"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvCa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnImportarCa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Importar CA manualmente (avançado)"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login: o app busca o certificado do servidor sozinho (deixe a senha em branco para manter o login atual)"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Usuário (ex: idoso1)"
        android:inputType="text"
        android:autofillHints="username" />

    <EditText
        android:id="@+id/etSenha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Senha"
        android:inputType="textPassword"
        android:autofillHints="password" />

</LinearLayout>
