<?xml version="1.0" encoding="utf-8"?>
<!--
    TLS: o app so fala HTTPS e nao aceita HTTP em texto claro. A confianca NAO vem daqui: o cliente HTTP do app (FlowHttp)
    confia so na CA do projeto, importada pela pessoa em Configuracoes (ou, se houver, a copia res/raw/flow_cert.pem), e
    nao nas autoridades do sistema nem do usuario. A verificacao do nome do servidor continua ligada: o IP do servidor
    precisa estar nos nomes do certificado dele. Reemitir o certificado do servidor (a CA nao muda) nao exige novo
    APK nem nova importacao; uma CA nova exige importar de novo o ca.crt.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
