# DOIS PROCESSOS (S5): borda e analise leem .env.borda e .env.analise (modelos: .env.borda.example e .env.analise.example) e
# NENHUM dos dois le este arquivo. Aqui ficam a senha administrativa e as dos papeis, para o compose e para
# "python -m flow_db provisionar|migrar". Para o PROCESSO UNICO ("python -m borda.server") este arquivo segue valendo inteiro.
#
# Configuracao do SERVIDOR. Copie este arquivo para ".env" (na mesma pasta) e preencha.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:           cp .env.example .env
# O ".env" NAO vai para o Git (so este modelo, sem segredos). Variavel de ambiente ja definida no terminal VENCE
# o arquivo. Valores com espaco ou "#" devem ficar entre aspas.

# OBRIGATORIA: segredo de assinatura dos tokens (minimo 32 bytes). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLOW_JWT_SECRET="wM1Dd9NLS6Nt2qJT_Vcl7ptXdLTjiMzbyhvJ8qNgjnXoqQmsne4vXawIQ1xMxprr"

# Opcionais (o padrao e o valor mostrado). Caminho relativo vale a partir da pasta de onde o servidor e iniciado:
# inicie sempre de dentro de SensorServer/ (ou use caminhos absolutos).
# FLOW_CONTAS_PATH=contas.json
# FLOW_SESSOES_PATH=sessoes.json

# A senha das contas NAO fica aqui: ela e pedida no terminal por "python -m borda.auth criar-conta".

# ---------------------------------------------------------------------------
# BANCO (docker-compose.yml desta pasta). O compose le este mesmo ".env".
# A SENHA e obrigatoria e so vale na primeira subida do volume (ver docker-compose.yml). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# ---------------------------------------------------------------------------
FLOW_DB_PASSWORD="7TD4G9AAf4lwqQjyvUa6s-M4ImfEJqfZ"
# Opcionais (o padrao e o valor mostrado):
# FLOW_DB_USER=flow
# FLOW_DB_NAME=flow
# FLOW_DB_PORT=5432

# Papeis de servico do banco (sem superusuario; criados por "python -m flow_db provisionar").
# Senhas: so letras, numeros, "_" e "-", minimo 16 (o gerador acima serve). Cada servico conhece SO a sua.
# FLOW_DB_PASSWORD (acima) e ADMINISTRATIVA: serve a migracoes, provisionamento e backup, nao ao servico.
# Enquanto borda e analise forem o mesmo processo, as duas senhas ficam aqui; ao separar, cada um tera o seu .env.
FLOW_DB_BORDA_PASSWORD="j_F0FIKICkryvEuJCCzHIbL6P8R1i7L-"
FLOW_DB_ANALISE_PASSWORD="KdQi15MhDvJBTLQRimXP7mrK6a3LMWNv"
# FLOW_DB_HOST=127.0.0.1

# Transicao: 1 (padrao) grava os arquivos de hoje alem do banco; 0 so no banco.
# FLOW_GRAVAR_ARQUIVOS=1
# FLOW_GRAVAR_TELEMETRIA_LEGADO=1

# Laco da analise por cursor (S3a do split): 1 (padrao) liga; 0 desliga. Na S3a ele so registra decisoes em log.
# FLOW_LACO_ANALISE=1

# Comparacao em modo sombra (S3b do split): 1 liga (exige o laco ligado); 0 (padrao) desliga. Grava dataUsers/sombra_decisoes.jsonl
# com as decisoes do caminho direto e do laco. Rode "python simular_cenarios.py" e depois "python relatorio_sombra.py".
# FLOW_SOMBRA=0

# Cutover das acoes (S4 do split): 1 = a ANALISE (laco por cursor) decide e grava no banco e a BORDA entrega o push a
# partir de comandos_push. 0 (padrao) = caminho direto, como sempre. Exige FLOW_LACO_ANALISE=1 (senao e ignorado, com aviso).
# Voltar atras: FLOW_ACOES_PELO_BANCO=0 e reiniciar. FLOW_SOMBRA e ignorado com este ligado.
# FLOW_ACOES_PELO_BANCO=0

# Saude do pipeline e recuperacao (S6 do split). Os valores mostrados sao os padroes.
# O /health acusa "degradado" se a analise passar deste tempo (s) sem batimento ou se o atraso passar deste numero de leituras
# (so com FLOW_ACOES_PELO_BANCO=1 ou na borda isolada). Valor invalido impede a subida.
# FLOW_LIMIAR_BATIMENTO_S=5
# FLOW_LIMIAR_ATRASO_LEITURAS=60
# Recuperacao do estado das regras na subida da analise: 0 desliga.
# FLOW_RECUPERAR_ESTADO=1
