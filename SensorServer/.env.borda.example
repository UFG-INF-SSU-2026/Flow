# Configuracao do servico BORDA (python -m borda). Copie para ".env.borda" (nesta pasta) e preencha.
#   Windows (PowerShell):  Copy-Item .env.borda.example .env.borda
#   Linux/macOS:           cp .env.borda.example .env.borda
# O ".env.borda" NAO vai para o Git. Variavel de ambiente ja definida no terminal VENCE o arquivo.
# A borda NAO pode ver a senha administrativa (FLOW_DB_PASSWORD) nem a senha da analise (FLOW_DB_ANALISE_PASSWORD):
# se estiverem no ambiente, ela se recusa a subir. Elas ficam so no ".env" administrativo (migracoes e provisionamento).

# OBRIGATORIA: segredo de assinatura dos tokens (minimo 32 bytes). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLOW_JWT_SECRET="troque-por-um-segredo-de-pelo-menos-32-bytes"

# OBRIGATORIA: senha do papel flow_borda (a MESMA usada em "python -m flow_db provisionar", no .env administrativo).
# So letras, numeros, "_" e "-", minimo 16.
FLOW_DB_BORDA_PASSWORD="troque-por-uma-senha-de-16-ou-mais-caracteres"

# Onde esta o banco (opcionais; o padrao e o valor mostrado):
# FLOW_DB_HOST=127.0.0.1
# FLOW_DB_PORT=5432
# FLOW_DB_NAME=flow

# Contas e sessoes (arquivos, so da borda). Caminho relativo vale a partir de SensorServer/:
# FLOW_CONTAS_PATH=contas.json
# FLOW_SESSOES_PATH=sessoes.json

# Transicao (o banco e a fonte; arquivos so se voce quiser os de antes): 0 so no banco.
# FLOW_GRAVAR_ARQUIVOS=0
# FLOW_GRAVAR_TELEMETRIA_LEGADO=1

# Saude do pipeline (S6): o /health acusa "degradado" quando a analise passa deste tempo (s) sem renovar o batimento, ou
# quando o atraso (em leituras) passa do limiar. Os valores mostrados sao os padroes.
# FLOW_LIMIAR_BATIMENTO_S=5
# FLOW_LIMIAR_ATRASO_LEITURAS=60
