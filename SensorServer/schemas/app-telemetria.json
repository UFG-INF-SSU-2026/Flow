{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow/app-telemetria",
  "title": "App Android -> servidor: telemetria (POST /dados)",
  "description": "Tolerante: nada e obrigatorio alem do roteamento. O bloco leitura_ambiente tem schema proprio.",
  "x-versao": 3,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "device_id": {
      "type": "string"
    },
    "device_model": {
      "type": "string"
    },
    "timestamp_envio": {
      "type": "number"
    },
    "sensores": {
      "type": "object"
    },
    "acelerometro": {
      "type": "object",
      "properties": {
        "magnitude": {
          "type": "number"
        },
        "magnitude_max_janela": {
          "type": "number"
        },
        "amostras": {
          "type": "integer",
          "minimum": 1
        },
        "janela_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "leitura_ambiente": {
      "type": "object"
    }
  }
}
