# Configuracao do BRIDGE. Copie este arquivo para ".env" (na mesma pasta) e preencha.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:           cp .env.example .env
# O ".env" NAO vai para o Git (so este modelo, sem segredos). Variavel de ambiente ja definida no terminal VENCE
# o arquivo. Valores com espaco ou "#" devem ficar entre aspas.

# OBRIGATORIAS: conta do bridge (papel "dispositivo", fonte "wokwi") e a senha dada ao criar a conta.
FLOW_BRIDGE_ID='bridge1'
FLOW_BRIDGE_SECRET=

# URL base do servidor. Use o IP (127.0.0.1) e nao "localhost": no Windows o "localhost" tenta IPv6 primeiro e
# cada conexao nova do bridge espera 1-2 s, o que atrasa toda a telemetria. Em outra maquina, use o IP dela.
FLOW_SERVIDOR='http://127.0.0.1:5000'

# deviceId do firmware que este bridge repassa. So mude se mudar o DEVICE_ID de sketch/sketch.ino.
# FLOW_BRIDGE_DEVICE=esp32-decisao-imobilidade-01
