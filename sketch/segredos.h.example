#pragma once
// Copie este arquivo para "segredos.h" (na mesma pasta) e preencha. O "segredos.h" NAO vai para o Git.
//
// Conta do tipo "dispositivo" criada no servidor para ESTE firmware (uma por dispositivo, fonte "wokwi"). O firmware e o dono
// do segredo: ele o entrega ao bridge no login (por HTTPS) e o bridge o repassa ao servidor sem guardar. Sem aspas nem barra
// invertida.
#define FLOW_IDENTIFICADOR "bridge1"
#define FLOW_SEGREDO       "troque-pela-senha-da-conta"

// URL do bridge. Precisa ser https:// (uma URL http:// nao compila). host.wokwi.internal e o PC visto de dentro da simulacao
// (gateway de rede do Wokwi; ver sketch/wokwi.toml) e precisa constar no certificado da API do bridge:
//   python scripts/gerar_certificado.py --forcar --nome bridge --dns host.wokwi.internal      (em SensorServer/)
// Se omitida, vale este mesmo padrao.
#define FLOW_BRIDGE_URL "https://host.wokwi.internal:5443"

// Chave PUBLICA da CA do projeto (SensorServer/certs/ca.crt): e o unico certificado em que o firmware confia. Cole o conteudo
// de ca.crt (nunca o de ca.key).
static const char FLOW_CA_PEM[] = R"PEM(
-----BEGIN CERTIFICATE-----
...cole aqui o conteudo de ca.crt...
-----END CERTIFICATE-----
)PEM";
